# Public browser configuration: never include secrets in VITE_ values.
VITE_MENU_MODE=demo
# published mode uses /venues/<UUID>/menus/<UUID>; API origin must be approved HTTPS.
VITE_PUBLIC_MENU_API_ORIGIN=

# Optional: enables the AI-powered waiter through Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Vercel deployments may provide this automatically through OIDC.
VERCEL_OIDC_TOKEN=

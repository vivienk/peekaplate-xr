{
  "name": "peekaplate-xr",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivienk/peekaplate-xr.git"
  },
  "scripts": {
    "predev": "node scripts/setup-browser-deps.mjs",
    "dev": "iwsdk dev restart --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "db:seed": "node --env-file-if-exists=.env.development.local scripts/seed-db.mjs",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "security:audit": "npm audit --audit-level=low",
    "check:live-menu": "node --experimental-strip-types scripts/check-published-menu.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.0-rc.2",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.140",
    "three": "npm:super-three@0.181.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.0-rc.2",
    "@iwsdk/reference": "1.0.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.0.0-rc.2",
    "@meta-quest/metavr": "^1.8.0",
    "@types/three": "^0.181.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "5.1.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}

<!--
  Panel and Divider come from the bundled Horizon kit, selected in
  iwsdk.config.json via world.features.spatialUI.kit. The `id` attributes below
  are the contract with ControllerInputSystem in src/input.ts — renaming one
  silently stops that field from updating.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 344px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 20px;
  }

  .heading {
    height: 32px;
    text-align: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .columns {
    flex-direction: row;
    width: 100%;
    margin-top: 10px;
  }

  .column {
    flex-direction: column;
    width: 50%;
  }

  .column-title {
    color: #767676;
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    margin-bottom: 4px;
  }

  .column-title:dark {
    color: rgba(255, 255, 255, 0.6);
  }

  .row {
    color: #272727;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  .row:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .legend {
    color: #767676;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    width: 100%;
    margin-top: 12px;
  }

  .legend:dark {
    color: rgba(255, 255, 255, 0.6);
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Controller Input</div>
    <Divider></Divider>
    <div class="columns">
      <div class="column">
        <div class="column-title">LEFT</div>
        <div id="l-x" class="row">X  off</div>
        <div id="l-y" class="row">Y  off</div>
        <div id="l-trigger" class="row">Trig  0.00</div>
        <div id="l-grip" class="row">Grip  off</div>
        <div id="l-stick" class="row">Stick  0.00, 0.00</div>
      </div>
      <div class="column">
        <div class="column-title">RIGHT</div>
        <div id="r-a" class="row">A  off</div>
        <div id="r-b" class="row">B  off</div>
        <div id="r-trigger" class="row">Trig  0.00</div>
        <div id="r-grip" class="row">Grip  off</div>
        <div id="r-stick" class="row">Stick  0.00, 0.00</div>
      </div>
    </div>
    <div class="legend">
      A scale up, B scale down, X next color, Y reset. Squeeze the grip near the
      cube to pick it up.
    </div>
  </div>
</Panel>

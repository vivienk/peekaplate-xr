{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "vr",
      "offer": "always",
      "features": {
        "handTracking": true,
        "gazeTracking": false,
        "hitTest": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "near": 0.001,
      "far": 200,
      "camera": {
        "position": [
          0,
          1.65,
          0
        ],
        "lookAt": [
          0,
          1.65,
          -2.8
        ]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": false,
      "physics": false,
      "sceneUnderstanding": false,
      "environmentRaycast": true,
      "spatialUI": false
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "injectOnBuild": true,
      "activation": {
        "source": "^(localhost|127\\.0\\.0\\.1|peekaplate-xr\\.vercel\\.app|peekaplate(?:-xr)?-[a-z0-9-]+-viviens-projects-842ec178\\.vercel\\.app)$"
      },
      "environment": "meeting_room"
    }
  }
}
